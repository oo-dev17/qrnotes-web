{
  "name": "qrnotes-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run build:assets && tsx watch src/server.ts",
    "build": "tsc && npm run build:assets",
    "build:assets": "npm run build:css && npm run build:client && npm run build:vendor",
    "build:css": "tailwindcss -i src/styles/app.css -o public/css/app.css",
    "build:client": "esbuild src/client/login.ts src/client/home.ts src/client/note.ts src/client/scan.ts src/client/note-form.ts src/client/sketch.ts --bundle --format=esm --target=es2022 --outdir=public/js --minify",
    "build:vendor": "node -e \"require('fs').copyFileSync('node_modules/htmx.org/dist/htmx.min.js','public/js/htmx.min.js')\"",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/formbody": "^9.0.2",
    "@fastify/multipart": "^10.1.9",
    "@fastify/static": "^8.2.0",
    "eta": "^4.6.0",
    "fastify": "^5.6.1",
    "fastify-plugin": "^5.1.0",
    "firebase-admin": "^13.6.0",
    "htmx.org": "^2.0.11",
    "konva": "^10.9.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.0",
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.2",
    "firebase": "^12.5.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
