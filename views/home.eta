<section class="flex flex-col gap-4 pt-4">
  <header class="flex flex-wrap items-start justify-between gap-3">
    <div>
      <h1 class="text-2xl font-bold">QrNotes</h1>
      <p class="text-sm text-neutral-400"><%= it.email %></p>
    </div>
    <div class="flex items-center gap-2">
      <a href="/scan" class="rounded-xl bg-neutral-800 px-4 py-2 text-sm font-medium hover:bg-neutral-700">Scan</a>
      <a href="/notes/new" class="rounded-xl bg-violet-600 px-4 py-2 text-sm font-medium text-white hover:bg-violet-500">New</a>
      <% const sortOptions = [
        { value: 'date-desc', label: 'Date: newest first' },
        { value: 'date-asc', label: 'Date: oldest first' },
        { value: 'name-asc', label: 'Name: A to Z' },
      ]; %>
      <details id="main-menu" class="relative">
        <summary
          class="flex h-9 w-9 cursor-pointer list-none items-center justify-center rounded-xl bg-neutral-800 text-lg hover:bg-neutral-700 [&::-webkit-details-marker]:hidden"
          aria-label="Menu"
        >&#9776;</summary>
        <div class="absolute right-0 z-20 mt-2 flex w-60 flex-col gap-1 rounded-xl bg-neutral-900 p-2 shadow-lg ring-1 ring-neutral-700">
          <fieldset class="flex flex-col gap-1">
            <legend class="px-2 pb-1 text-xs uppercase tracking-wide text-neutral-500">Sort</legend>
            <% sortOptions.forEach(function (opt) { %>
              <label class="flex cursor-pointer items-center gap-3 rounded-lg px-3 py-2 text-sm hover:bg-neutral-800">
                <input
                  type="radio"
                  name="sort"
                  value="<%= opt.value %>"
                  <%= it.sort === opt.value ? 'checked' : '' %>
                  hx-get="/notes"
                  hx-target="#note-list"
                  hx-swap="innerHTML"
                  hx-include="[name='q']"
                  onchange="this.closest('details').open = false"
                  class="accent-violet-600"
                >
                <span><%= opt.label %></span>
              </label>
            <% }) %>
          </fieldset>
          <div class="mt-1 border-t border-neutral-800 pt-2">
            <button
              id="logout-btn"
              type="button"
              class="w-full rounded-lg px-3 py-2 text-left text-sm text-red-300 hover:bg-neutral-800"
            >Sign out</button>
          </div>
        </div>
      </details>
    </div>
  </header>

  <form role="search" class="contents" onsubmit="return false">
    <input
      type="search"
      name="q"
      placeholder="Search"
      autocomplete="off"
      aria-label="Search notes"
      hx-get="/notes"
      hx-trigger="input changed delay:300ms, search"
      hx-target="#note-list"
      hx-swap="innerHTML"
      hx-include="[name='sort']:checked"
      class="w-full rounded-xl border border-neutral-700 bg-neutral-900 px-4 py-3 text-base placeholder:text-neutral-500 focus:border-violet-500 focus:outline-none"
    >
  </form>

  <div id="note-list" class="-mx-6 divide-y divide-neutral-800" data-live-fp="<%= it.liveFp %>">
    <%~ it.listHtml %>
  </div>
</section>
<%~ include('partials/live-banner', {}) %>
<script src="/static/js/htmx.min.js" defer></script>
<script type="module" src="/static/js/home.js"></script>
