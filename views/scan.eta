<section class="flex flex-col gap-5 pb-10 pt-4" data-return="<%= it.returnTo %>">
  <header class="flex items-center gap-3">
    <a href="<%= it.cancelHref %>" class="flex h-9 w-9 items-center justify-center rounded-xl border border-neutral-600 bg-neutral-800 text-neutral-200 hover:bg-neutral-700" aria-label="Back"><svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg></a>
    <h1 class="text-xl font-semibold">Code scannen</h1>
  </header>

  <div class="aspect-square overflow-hidden rounded-xl bg-black">
    <video id="scan-video" playsinline muted class="h-full w-full object-cover"></video>
  </div>

  <p id="scan-status" role="status" class="min-h-6 text-center text-sm text-neutral-400">Starting camera …</p>

  <a href="<%= it.cancelHref %>" class="rounded-xl bg-neutral-800 px-6 py-3 text-center font-medium hover:bg-neutral-700">Cancel</a>
</section>
<script type="module" src="/static/js/scan.js"></script>
