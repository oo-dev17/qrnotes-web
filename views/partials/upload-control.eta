<form method="post" action="<%= it.action %>" enctype="multipart/form-data" class="contents">
  <% if (it.tile) { %>
    <label class="js-upload relative flex h-32 w-32 shrink-0 cursor-pointer snap-start items-center justify-center rounded-xl border-2 border-dashed border-neutral-700 text-3xl text-neutral-400 hover:border-violet-500 hover:text-violet-400">
      <span class="js-upload-text" aria-label="Add"><%= it.label %></span>
      <input type="file" name="files" accept="<%= it.accept %>" multiple class="sr-only js-autoupload">
    </label>
  <% } else { %>
    <label class="js-upload relative cursor-pointer rounded-xl bg-violet-600 px-4 py-2 text-sm font-medium text-white hover:bg-violet-500">
      <span class="js-upload-text"><%= it.label %></span>
      <input type="file" name="files" accept="<%= it.accept %>" multiple class="sr-only js-autoupload">
    </label>
  <% } %>
</form>
