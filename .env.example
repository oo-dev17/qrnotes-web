# Kopieren nach .env und ausfüllen. .env und secrets/ bleiben aus Git raus.

PORT=3000

# Firebase-Web-Config (Projekt-Einstellungen > Allgemein > Web-App)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=qrnotes-f41bf.firebaseapp.com
FIREBASE_PROJECT_ID=qrnotes-f41bf
FIREBASE_STORAGE_BUCKET=qrnotes-f41bf.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Service-Account-JSON für firebase-admin (Pfad, nicht der Inhalt)
GOOGLE_APPLICATION_CREDENTIALS=./secrets/serviceAccount.json
