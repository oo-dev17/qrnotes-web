# Copy to .env and fill in. .env and secrets/ stay out of Git.

PORT=3000

# Firebase web config (Project settings > General > Web app)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=qrnotes-f41bf.firebaseapp.com
FIREBASE_PROJECT_ID=qrnotes-f41bf
FIREBASE_STORAGE_BUCKET=qrnotes-f41bf.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Service account JSON for firebase-admin (path, not the content)
GOOGLE_APPLICATION_CREDENTIALS=./secrets/serviceAccount.json
